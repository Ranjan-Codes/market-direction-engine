# ── Supabase ──────────────────────────────────────────────────────────────────
# Server-side only (GitHub Actions jobs + Next.js server routes). NEVER exposed to client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Session-pooler connection string (dashboard → Connect → Direct) for migrations.
# Keep the [YOUR-PASSWORD] placeholder — the password is spliced in from the var below.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# Client-safe read layer (anon key is safe to expose ONLY because RLS denies by default;
# the Netlify app reads via server routes using the service key, so these may stay unused).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Market data providers (free tiers — all optional; provider registry skips missing) ──
ALPHA_VANTAGE_API_KEY=
TIINGO_API_KEY=
TWELVE_DATA_API_KEY=
EODHD_API_KEY=

# ── Macro / economic ──────────────────────────────────────────────────────────
FRED_API_KEY=

# ── Broker integrations ──────────────────────────────────────────────────────
# IG trading API — sync positions and watchlists directly (optional)
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=
IG_ACCOUNT_TYPE=live

# ── Social sentiment ──────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=market-direction-engine/0.1 (single-user research tool)
